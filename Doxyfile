# Run scripts/build_docs.sh from any directory; generated files stay in .tools/.
PROJECT_NAME           = ESA
PROJECT_BRIEF          = "Read-only engineering support and independent system replay"
OUTPUT_DIRECTORY       = .tools/doxygen
OUTPUT_LANGUAGE        = English
INPUT_ENCODING         = UTF-8
INPUT                  = docs/doxygen cmd internal system_replay scripts deploy/tools/sootup
FILE_PATTERNS          = *.go *.py *.java *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.tools/* */__pycache__/* */*_test.go */test_*.py */verify_*.py
EXTENSION_MAPPING      = go=C++
FILTER_PATTERNS        = "*.go=.tools/doxygen-go"
FILTER_SOURCE_FILES    = NO
# Go is represented as pages with real signatures, not synthetic C++ symbols.
SOURCE_BROWSER         = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
PYTHON_DOCSTRING       = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = .tools/doxygen/warnings.log
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
FULL_PATH_NAMES        = NO
