# Copy to .env and fill with newly generated local secrets.
# Empty required values intentionally prevent deployment until configured.
REDMINE_DB_PASSWORD=
SECRET_KEY_BASE=
ESA_API_TOKEN=
# Optional routing/engineering provider. Leave empty to await configuration.
ESA_ANALYZER_URL=

# Shared Issue directory on the host; match esa-codex -issues-directory.
ESA_ISSUES_DIRECTORY=../../runtime/esa/issues
