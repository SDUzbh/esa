# Copy to .env and fill with newly generated local secrets.
# Empty required values intentionally prevent deployment until configured.
REDMINE_DB_PASSWORD=
SECRET_KEY_BASE=
ESA_API_TOKEN=
# Optional routing/engineering provider. Leave empty to await configuration.
ESA_ANALYZER_URL=
# Keep the default for container-only deployments. A host Codex provider needs
# matching ownership of the shared directory: use `id -u` / `id -g` locally.
ESA_UID=1000
ESA_GID=1000

# Shared Issue directory on the host; match esa-codex -issues-directory.
ESA_ISSUES_DIRECTORY=../../runtime/esa/issues

# Password of ESA's own Postgres role, which keeps ESA's state
# (docs/ESA_OPERATIONS.md#postgres-state-store). Required. Compose creates the
# role and database from it; use hex (openssl rand -hex 24) so it needs no URL
# encoding.
ESA_DB_PASSWORD=
