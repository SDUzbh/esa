# Copy to .env and fill with newly generated local secrets.
# Empty required values intentionally prevent deployment until configured.
REDMINE_DB_PASSWORD=
SECRET_KEY_BASE=
ESA_API_TOKEN=
# Optional routing/engineering provider. Leave empty to await configuration.
ESA_ANALYZER_URL=
# Keep the default for container-only deployments. A host Codex provider needs
# matching ownership of the shared directory: use `id -u` / `id -g` locally.
ESA_UID=1000
ESA_GID=1000

# Shared Issue directory on the host; match esa-codex -issues-directory.
ESA_ISSUES_DIRECTORY=../../runtime/esa/issues

# Optional Postgres state store (docs/ESA_OPERATIONS.md#postgres-state-store).
# Leave both empty to keep the JSON store. Use a hex secret (openssl rand -hex 24)
# so it needs no URL encoding, and repeat it in the URL:
#   ESA_DATABASE_URL=postgres://esa:<ESA_DB_PASSWORD>@db:5432/esa?sslmode=disable
ESA_DB_PASSWORD=
ESA_DATABASE_URL=
# Only while importing from the retired Redmine state API (ESA_STATE_URL); set 1,
# import, then remove both.
ESA_STATE_API_ENABLED=
