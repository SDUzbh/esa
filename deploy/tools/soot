#!/bin/sh
# Inspect registered product bytecode using the analysis JVM and target libraries.
set -eu
explicit_classpath=false
for argument do
    case "$argument" in
        -cp|-soot-class-path|-soot-classpath) explicit_classpath=true; break ;;
    esac
done
if [ "$explicit_classpath" = false ]; then
    classpath=/input/classes
    for jar in /input/deps/*.jar /opt/java/openjdk/jre/lib/*.jar /opt/java/openjdk/jre/lib/ext/*.jar; do
        if [ -f "$jar" ]; then classpath="$classpath:$jar"; fi
    done
    set -- -cp "$classpath" "$@"
fi
# An explicit Soot classpath replaces the default. Preserve argument boundaries
# and let Soot reject missing values or duplicate caller-supplied options.
exec /opt/esa/tool-jdk/bin/java -Xmx1024m -cp /opt/esa/soot/soot.jar soot.Main \
    -src-prec only-class "$@"
