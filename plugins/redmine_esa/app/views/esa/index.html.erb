<% html_title 'ESA' %>
<div class="contextual"><%= link_to 'Upload tickets', esa_upload_path, class: 'icon icon-add' if @projects.any? { |p| User.current.allowed_to?(:submit_esa, p) } %></div>
<h2>ESA</h2>
<p>Engineering support, case recommendations, and read-only diagnosis.</p>
<%= form_tag esa_path, method: :get do %>
<fieldset><legend>Filters</legend>
<p><%= label_tag :q, 'Search' %> <%= text_field_tag :q, @query['q'], placeholder: 'Issue key or subject' %>
<%= label_tag :project_id, 'Project' %> <%= select_tag :project_id, options_for_select([['All authorized projects', '']] + @projects.map { |p| [p.name, p.id] }, @query['project_id']) %></p>
<p><% { 'route' => ['', 'issue_reuse', 'engineering_analysis', 'case_collection', 'manual_forward'], 'esa_state' => ['', 'queued', 'awaiting_information', 'awaiting_configuration', 'running', 'investigating', 'awaiting_review', 'completed', 'failed', 'draft', 'trusted', 'invalidated', 'rejected', 'archived', 'duplicate'], 'source' => ['', 'redmine', 'manual_upload'] }.each do |name, options| %>
<%= label_tag name, esa_label(name) %> <%= select_tag name, options_for_select(options.map { |v| [v.blank? ? 'Any' : esa_label(v), v] }, @query[name]) %>
<% end %></p>
<p><% %w[tracker status assignee].each do |name| %><%= label_tag name, esa_label(name) %> <%= text_field_tag name, @query[name], size: 16 %> <% end %></p>
<p><%= label_tag :updated_from, 'Updated from' %> <%= text_field_tag :updated_from, @query['updated_from'], placeholder: '2026-10-11T00:00:00Z' %>
<%= label_tag :updated_to, 'Updated to' %> <%= text_field_tag :updated_to, @query['updated_to'], placeholder: 'ISO 8601 with timezone' %></p>
<%= submit_tag 'Apply', name: nil %> <%= link_to 'Clear', esa_path %>
</fieldset>
<% end %>
<% if @result['tickets'].empty? %><p class="nodata">No ESA tickets match these filters. Open an authorized Redmine issue and choose Forward to ESA. Creating, editing or importing an issue does not forward it.</p><% else %>
<div class="autoscroll"><table class="list issues"><thead><tr>
<% { 'id' => 'Issue', 'subject' => 'Subject', 'project' => 'Project', 'tracker' => 'Tracker', 'status' => 'Status', 'esa_state' => 'ESA state', 'assignee' => 'Assignee', 'source' => 'Source', 'updated_at' => 'Updated' }.each do |key, label| %><th><%= esa_sort_link(label, key) %></th><% end %>
<th>Route</th></tr></thead><tbody>
<% @result['tickets'].each do |row| %><% ticket = row['ticket']; id = ticket['id'].delete_prefix('redmine:'); record = ticket['closed'] ? row['case'] : row['latest_run'] %>
<tr><td><%= link_to "##{id}", esa_ticket_path(id) %></td><td class="subject"><%= link_to ticket['subject'], esa_ticket_path(id) %><br><%= ticket['source_key'] %></td><td><%= ticket['project'] %></td><td><%= ticket['tracker'] %></td><td><%= ticket['status'] %></td><td><%= esa_label(esa_row_state(row)) %></td><td><%= ticket['assignee'] %></td><td><%= esa_label(ticket['source']) %></td><td><%= record&.fetch('updated_at', nil) || ticket['updated_at'] %></td><td><%= esa_label(ticket['closed'] ? 'case_collection' : record&.fetch('route', nil)) %></td></tr>
<% end %></tbody></table></div>
<% end %>
<p><%= @result['total_count'] %> matching tickets. Page <%= @result['page'] %>.
<%= link_to 'Previous', esa_path(@query.merge('page' => @result['page'] - 1)) if @result['page'] > 1 %>
<%= link_to 'Next', esa_path(@query.merge('page' => @result['page'] + 1)) if @result['page'] * @result['limit'] < @result['total_count'] %></p>
