<% html_title @issue.subject, 'ESA' %>
<div class="contextual"><%= link_to 'Original issue', issue_path(@issue), class: 'icon icon-issue' %> <%= link_to 'All ESA tickets', esa_path %></div>
<h2>ESA · #<%= @issue.id %> <%= @issue.subject %></h2>
<% run = @row['latest_run']; record = @row['case'] %>
<% task = @row['investigation']; solution = @row['solution']; engineering_issue = @row['engineering_issue'] %>
<% if task %><div class="box"><h3>Shared engineering investigation</h3>
<p><strong>Engineering issue:</strong> <%= engineering_issue ? engineering_issue['id'] : 'Unassigned until analysis completes' %> · <strong>Investigation:</strong> <%= esa_label(task['state']) %></p>
<p><%= link_to 'Engineering issue list', esa_engineering_issues_path %></p>
<p>Tickets share an investigation when diagnostic content, affected versions, components and environment match. Membership remains tentative until reviewed.</p>
<% if solution %><p><strong>Solution:</strong> Revision <%= solution['revision'] %> · <%= esa_label(solution['state']) %> · <%= solution['origin'] %></p>
<% if solution['state'] == 'proposed' %><p class="warning">Agent proposal awaiting engineer review. Source citations alone do not verify the cause or repair.</p><% end %>
<% if solution['state'] == 'trusted' %><% %w[cause solution validation].each do |field| %><p><strong><%= esa_label(field) %>:</strong> <%= solution.dig('resolution', field) %></p><% end %><p>Reviewed by <%= solution['reviewer'] %>. <%= solution['note'] %></p><% end %>
<% else %><p>There is no solution available within the current visibility and observation scope.</p><% end %>
</div><% end %>
<div class="box"><p><strong>ESA state:</strong> <%= esa_label(esa_row_state(@row)) %></p>
<p><strong>Intake:</strong> <%= @row.dig('ticket', 'forwarded_by').present? ? "Forwarded by #{@row.dig('ticket', 'forwarded_by')}" : 'Not forwarded to ESA' %></p>
<% if run && !@issue.closed? %><p><strong>Route:</strong> <%= esa_label(run['route']) %></p>
<% routing = run.dig('report', 'routing') %>
<% if routing %><p><strong>Routing decision:</strong> <%= esa_label(routing['action']) %> · <%= routing['reason'] %></p>
<% if routing['action'] == 'reuse' %><p>Existing solution reused. The engineering Agent was not invoked.</p><% end %>
<p><strong>Routing calls:</strong> <%= routing.dig('usage', 'calls') || 0 %> · <strong>Engineering calls:</strong> <%= [run.dig('report', 'usage', 'calls').to_i - routing.dig('usage', 'calls').to_i, 0].max %></p><% end %>
<p><%= run.dig('report', 'summary') %></p>
<% Array(run.dig('report', 'alerts')).each do |alert| %><p class="warning"><strong>Analysis warning:</strong> <%= alert['message'] %></p><% end %>
<% Array(run.dig('report', 'environment_requests')).each do |request| %><div class="box"><h3>Environment change requested</h3><p><%= request['reason'] %></p><p><strong>Proposed change:</strong> <%= request['proposed_change'] %></p><p><strong>Validation:</strong> <%= request['validation'] %></p><p>Pending engineer review.</p></div><% end %>
<% if run['error'].present? %><p class="warning"><%= run['error'] %></p><% end %>
<% Array(run['missing_information']).each do |item| %><p class="warning">Required: <%= item %></p><% end %>
<% unless Array(run.dig('report', 'findings')).empty? %><h3>Code findings</h3><% run['report']['findings'].each do |finding| %><div class="box"><p><strong><%= finding['file'] %>:<%= finding['start_line'] %>–<%= finding['end_line'] %></strong><br>Commit: <%= finding['commit'] %></p><p><strong>Problem:</strong> <%= finding['problem'] %></p><p><strong>Solution:</strong> <%= finding['solution'] %></p></div><% end %><% end %>
<% %w[root_cause_candidates recommendations verification_steps limitations].each do |section| %><% values = Array(run.dig('report', section)) %><% unless values.empty? %><h3><%= esa_label(section) %></h3><ul><% values.each do |value| %><li><%= value %></li><% end %></ul><% end %><% end %>
<% unless Array(run.dig('report', 'evidence')).empty? %><h3>Evidence</h3><% run['report']['evidence'].each do |evidence| %><p><strong><%= evidence['source'] %> · <%= evidence['reference'] %></strong><br><%= evidence['quote'] %></p><% end %><% end %>
<p><strong>Provider calls:</strong> <%= run.dig('report', 'usage', 'calls') || 0 %> · <strong>Tokens:</strong> <%= run.dig('report', 'usage', 'tokens_reported') ? "#{run.dig('report', 'usage', 'input_tokens')} input / #{run.dig('report', 'usage', 'output_tokens')} output" : 'No provider usage report' %></p>
<% end %>
<% if record %><h3>Collected case · <%= esa_label(record['state']) %></h3><p><%= record['summary'] %></p><% %w[cause solution validation].each do |field| %><p><strong><%= esa_label(field) %>:</strong> <%= record.dig('resolution', field) %></p><% end %><p>Case revision <%= record['version'] %>. Reviewed by <%= record['reviewed_by'] %>. <%= record['review_note'] %></p><% end %>
</div>
<% classifier = @result['classifier'] %>
<% if classifier && classifier['enabled'] %>
<div class="box"><h3>Optional label suggestions</h3>
<p>Suggestions describe the last manually forwarded subject and description. Human labels are saved for supervised training and do not change engineering routing.</p>
<p><strong>Model:</strong> <%= classifier['model_version'] %> · <strong>Training through:</strong> <%= classifier['training_through'] %></p>
<% if classifier['blocked_reason'].present? %><p class="warning"><%= classifier['blocked_reason'] %></p>
<% elsif User.current.allowed_to?(:submit_esa, @issue.project) %><%= form_tag esa_classifier_predict_path(@issue) do %><%= submit_tag 'Suggest labels' %><% end %><% end %>
<% prediction = classifier['prediction']; feedback = classifier['feedback'] %>
<% if prediction %>
<p><strong>Prediction:</strong> <%= esa_label(prediction.dig('prediction', 'status')) %></p>
<p>Scores are independent model estimates, not calibrated confidence.</p>
<table class="list"><thead><tr><th>Label</th><th>Score</th><th>Suggested</th></tr></thead><tbody>
<% Array(prediction.dig('prediction', 'scores')).each do |score| %><tr><td><%= score['label'] %></td><td><%= format('%.3f', score['score']) %></td><td><%= Array(prediction.dig('prediction', 'labels')).include?(score['label']) ? 'Yes' : 'No' %></td></tr><% end %>
</tbody></table>
<% if feedback %><p><strong>Human labels:</strong> <%= Array(feedback.dig('example', 'labels')).join(', ').presence || 'None' %> · Reviewed by <%= feedback.dig('example', 'reviewer') %></p><% end %>
<% if User.current.allowed_to?(:review_esa, @issue.project) %>

<%= form_tag esa_classifier_feedback_path(@issue) do %>
<%= hidden_field_tag :prediction_id, prediction['id'] %><%= hidden_field_tag :feedback_id, SecureRandom.uuid %>
<% selected = feedback ? Array(feedback.dig('example', 'labels')) : [] %>
<p>Confirm all applicable labels. Leave all unchecked to confirm that none apply.</p>
<% Array(classifier['labels']).each_with_index do |label, index| %><p><%= check_box_tag 'labels[]', label, selected.include?(label), id: "esa_classifier_label_#{index}" %> <%= label_tag "esa_classifier_label_#{index}", label %></p><% end %>
<p><%= label_tag :feedback_note, 'Review note' %> <%= text_field_tag :feedback_note, '', size: 65, maxlength: 4000 %></p>
<%= submit_tag 'Confirm human labels' %><% end %><% end %>
<% end %></div><% end %>
<% if User.current.allowed_to?(:submit_esa, @issue.project) %>
<%= form_tag esa_forward_path(@issue) do %><%= submit_tag @issue.closed? ? 'Forward resolved issue to ESA' : 'Forward to ESA' %> <%= check_box_tag :force, '1' %> <%= label_tag :force, 'Force a new run (may consume the analysis budget)' %><% end %>
<h3>ESA metadata</h3>
<%= form_tag esa_metadata_path(@issue) do %><div class="box tabular">
<p><%= label_tag :components, 'Components' %><%= text_field_tag :components, Array(@metadata['components']).join('; '), size: 60 %></p>
<p><%= label_tag :versions, 'Affected versions' %><%= text_field_tag :versions, Array(@metadata['versions']).join('; '), size: 60 %></p>
<p><%= label_tag :environment, 'Environment (JSON)' %><%= text_area_tag :environment, JSON.pretty_generate(@metadata['environment'] || {}), rows: 4, cols: 75 %></p>
<% { 'resolution_reason' => 'reason', 'cause' => 'cause', 'solution' => 'solution', 'validation' => 'validation' }.each do |name, field| %><p><%= label_tag name, esa_label(name) %><%= text_area_tag name, @metadata.dig('resolution', field), rows: 3, cols: 75 %></p><% end %>
</div><%= submit_tag 'Save metadata locally' %><% end %><% end %>
<% if User.current.allowed_to?(:review_esa, @issue.project) %>
<% if task && engineering_issue && !@issue.closed? %><h3>Review issue membership</h3><%= form_tag esa_review_membership_path(@issue) do %>
<%= hidden_field_tag :snapshot_id, @row['snapshot_id'] %>
<p><%= label_tag :engineering_issue_id, 'Engineering issue ID' %> <%= text_field_tag :engineering_issue_id, '', size: 50 %> Leave blank to split into a new issue.</p>
<p><%= label_tag :membership_reason, 'Reason and contradictory evidence' %> <%= text_field_tag :membership_reason, '', size: 65, required: true %></p>
<%= submit_tag 'Revise membership' %><% end %><% end %>
<% if record && @issue.closed? %><h3>Case review</h3><%= form_tag esa_review_case_path(@issue) do %><%= text_field_tag :note, '', placeholder: 'Review evidence and applicability', size: 65 %><%= button_tag 'Approve trusted case', name: :review_action, value: 'approve' %><%= button_tag 'Reject case', name: :review_action, value: 'reject' %><% end %><% end %>
<% if task && solution %><h3>Shared solution review</h3><%= form_tag esa_review_investigation_path(@issue) do %>
<%= hidden_field_tag :solution_id, solution['id'] %><div class="box tabular">
<% %w[cause solution validation].each do |field| %><p><%= label_tag field, esa_label(field) %><%= text_area_tag field, solution.dig('resolution', field), rows: 3, cols: 75 %></p><% end %>
<p><%= label_tag :note, 'Review note' %><%= text_field_tag :note, '', size: 65 %></p></div>
<%= button_tag 'Publish reviewed solution', name: :review_action, value: 'approve' %> <%= button_tag 'Reject proposal', name: :review_action, value: 'reject' %> <%= button_tag 'Withdraw solution', name: :review_action, value: 'withdraw' %>
<% end %><% end %>
<% end %>
<h3>Run history</h3><table class="list"><thead><tr><th>Created</th><th>State</th><th>Route</th><th>Config version</th><th>Provider calls</th></tr></thead><tbody><% @result['history'].each do |item| %><tr><td><%= item['created_at'] %></td><td><%= esa_label(item['state']) %></td><td><%= esa_label(item['route']) %></td><td><%= item['rule_version'] %></td><td><%= item.dig('report', 'usage', 'calls') || 0 %></td></tr><% end %></tbody></table>
