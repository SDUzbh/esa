{
  "schema_version": 1,
  "target": {
    "url": "http://127.0.0.1:18090",
    "start": {
      "args": [
        "{{manifest_dir}}/../../bin/esa-host",
        "-listen",
        "127.0.0.1:18090",
        "-store",
        "{{run_dir}}/target/state.json",
        "-rules",
        "{{manifest_dir}}/../../config/rules.json"
      ],
      "env": {
        "ESA_API_TOKEN": "{{token}}",
        "ESA_REDMINE_URL": "",
        "ESA_ANALYZER_URL": ""
      }
    },
    "headers": {
      "X-ESA-Project-IDs": "{{project_id}}"
    },
    "submit": {
      "method": "POST",
      "path": "/v1/events",
      "body": {
        "id": "{{event_id}}",
        "origin": "system_replay",
        "occurred_at": "{{event_time}}",
        "ticket": "{{ticket}}",
        "forwarded_by": "fixture-human",
        "forwarded_at": "{{event_time}}"
      }
    },
    "observe": {
      "path": "/v1/tickets/{{ticket_id}}"
    },
    "extract": {
      "state": [
        "/ticket/latest_run/state",
        "/ticket/case/state"
      ],
      "route": [
        "/ticket/latest_run/route"
      ],
      "issue_id": [
        "/ticket/latest_run/report/issue/existing_id"
      ],
      "findings": [
        "/ticket/latest_run/report/findings"
      ],
      "usage": [
        "/ticket/latest_run/report/usage"
      ],
      "run_id": [
        "/ticket/latest_run/id"
      ]
    },
    "capture": {
      "case_id": "/ticket/case/id",
      "run_id": "/ticket/latest_run/id"
    },
    "terminal_states": [
      "completed",
      "awaiting_configuration",
      "awaiting_information",
      "awaiting_review",
      "failed",
      "restricted",
      "invalidated",
      "draft",
      "trusted",
      "rejected",
      "duplicate",
      "archived"
    ],
    "timeout_seconds": 30,
    "poll_milliseconds": 100
  },
  "warn_input_tokens": 16000,
  "warn_output_tokens": 6000,
  "warn_total_tokens": 22000,
  "jobs": [
    {
      "id": "manual-forwarding",
      "version": "1.0",
      "at": "2020-01-01T00:00:00Z",
      "ticket": {
        "id": "FORWARD-1",
        "source_key": "FORWARD-1",
        "project_id": "1",
        "subject": "Unclassified request for engineer assistance",
        "description": "Failure while consuming records; reproduction attached.",
        "tracker": "Support",
        "status": "New",
        "components": [
          "consumer"
        ],
        "versions": [
          "1.0"
        ],
        "environment": {},
        "created_at": "2020-01-01T00:00:00Z",
        "updated_at": "2020-01-01T00:00:00Z",
        "closed": false,
        "resolution": {}
      },
      "expect": [
        {
          "path": "/state",
          "op": "eq",
          "value": "awaiting_information"
        }
      ],
      "events": [
        {
          "at": "2020-01-02T00:00:00Z",
          "skip_observe": true,
          "request": {
            "method": "POST",
            "path": "/v1/events",
            "body": {
              "id": "auto-event",
              "origin": "redmine",
              "occurred_at": "{{event_time}}",
              "ticket": {
                "id": "AUTO-1",
                "source_key": "FORWARD-1",
                "project_id": "1",
                "subject": "Unclassified request for engineer assistance",
                "description": "Failure while consuming records; reproduction attached.",
                "tracker": "Support",
                "status": "New",
                "components": [
                  "consumer"
                ],
                "versions": [
                  "1.0"
                ],
                "environment": {},
                "created_at": "2020-01-01T00:00:00Z",
                "updated_at": "2020-01-01T00:00:00Z",
                "closed": false,
                "resolution": {}
              }
            }
          },
          "receipt_expect": [
            {
              "path": "/status",
              "op": "eq",
              "value": 400
            }
          ]
        },
        {
          "at": "2020-01-03T00:00:00Z",
          "skip_observe": true,
          "request": {
            "path": "/v1/tickets"
          },
          "receipt_expect": [
            {
              "path": "/body/total_count",
              "op": "eq",
              "value": 1
            }
          ]
        },
        {
          "at": "2020-01-04T00:00:00Z",
          "ticket": {
            "id": "FORWARD-1",
            "source_key": "FORWARD-1",
            "project_id": "1",
            "subject": "Unclassified request for engineer assistance",
            "description": "Failure while consuming records; reproduction attached.",
            "tracker": "Support",
            "status": "New",
            "components": [
              "consumer"
            ],
            "versions": [
              "1.0"
            ],
            "environment": {
              "details": "Fixture Java 8"
            },
            "created_at": "2020-01-01T00:00:00Z",
            "updated_at": "2020-01-04T00:00:00Z",
            "closed": false,
            "resolution": {}
          },
          "expect": [
            {
              "path": "/route",
              "op": "eq",
              "value": "engineering_analysis"
            },
            {
              "path": "/state",
              "op": "eq",
              "value": "awaiting_configuration"
            },
            {
              "path": "/raw/ticket/ticket/forwarded_by",
              "op": "eq",
              "value": "fixture-human"
            }
          ]
        },
        {
          "at": "2020-01-05T00:00:00Z",
          "skip_observe": true,
          "request": {
            "path": "/v1/labels"
          },
          "receipt_expect": [
            {
              "path": "/status",
              "op": "eq",
              "value": 404
            }
          ]
        }
      ]
    }
  ]
}
